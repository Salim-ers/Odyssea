# ---------------------------------------------------------------------------
# Odyssea — variables d'environnement
# Local : copiez ce fichier en .env.local puis lancez `npm run dev`
# Vercel : Project Settings → Environment Variables
# ---------------------------------------------------------------------------

# OBLIGATOIRE — composition des voyages et assistant.
# La clé reste côté serveur, elle n'atteint jamais le navigateur.
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel — modèle utilisé. Par défaut claude-opus-5.
# ODYSSEA_MODEL=claude-opus-5

# Comptes et voyages sauvegardés.
# Absent : Odyssea bascule sur SQLite dans .data/ (développement uniquement —
# une fonction serverless n'a pas de disque persistant).
# Présent : n'importe quel Postgres. Sur Vercel, créez une base Postgres et
# la variable est renseignée pour vous.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
