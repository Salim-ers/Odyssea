{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  }
}
